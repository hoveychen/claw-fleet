[Unit]
Description=Mirror stable Claw Fleet releases to the Shenzhen download site
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=fleet-site
Group=fleet-site
UMask=0022
ExecStart=/usr/bin/python3 -u /opt/fleet-site-updater/selfhost.py --root /srv/claw-fleet-site --public-url https://fleet.eternizedlab.com
# Bound every unattended run, while selfhost.py retains the same-tag stage so
# verified files and Range partials accumulate safely across timer rounds.
TimeoutStartSec=45min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/claw-fleet-site
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
