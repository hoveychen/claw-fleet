{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      }
    ],
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "extensionAbilities": [
      {
        // 系统分享的接收端。只在 UIAbility 上声明 sendData skill 不够 —— 真机
        // 上 utd 已登记进 bm dump,分享面板里依然没有 Fleet;面板要求接收方
        // 提供一个 share 类型的 UIExtension(SDK 的 ShareExtensionAbility)。
        "name": "ShareExtAbility",
        "srcEntry": "./ets/shareability/ShareExtAbility.ets",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "type": "share",
        "exported": true,
        "skills": [
          {
            "actions": ["ohos.want.action.sendData"],
            // utd 而非 mime type;每条都必须带 scheme,否则构建期 schema 就挂。
            "uris": [
              { "scheme": "file", "utd": "general.text" },
              { "scheme": "file", "utd": "general.image" },
              { "scheme": "file", "utd": "general.object" }
            ]
          }
        ]
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ]
  }
}