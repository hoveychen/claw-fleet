# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /src
COPY mobile-web/package.json mobile-web/pnpm-lock.yaml mobile-web/pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY mobile-web/ ./
ARG VITE_CLOUD_API_URL=/api/v1
ENV VITE_CLOUD_API_URL=$VITE_CLOUD_API_URL
RUN pnpm build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/cloud/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080

