<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Link for pairing: the desktop QR encodes
                 https://<relay-host>/#k=<secret>. With autoVerify the OS checks
                 /.well-known/assetlinks.json on that host against this package's
                 signing certificate and, on success, opens the link here instead
                 of in a browser — which is the only way the shell ever receives
                 a pairing secret (see src/deepLink.ts). The fragment carrying
                 the secret is never sent to the relay.

                 BOTH relay hostnames have to be claimed, because the host in the
                 QR is chosen by the *desktop's* region, not by this build
                 (claw-fleet-core/src/relay_region.rs: CN -> eternizedlab, else
                 -> muveeai). Claiming only one leaves every user on the other
                 side unable to pair at all — their scan opens a browser. Both
                 hosts front the same relay and serve the same assetlinks.json
                 with this keystore's SHA-256, so both verify.

                 The coupling that buys: on Android 11 and lower the system
                 makes the app default handler "only if it finds a matching
                 Digital Asset Links file for *all* hosts in the manifest"
                 (developer.android.com/training/app-links/verify-android-applinks),
                 and minSdk here is 24. So if either host ever stops serving
                 /.well-known/assetlinks.json, pairing breaks on pre-12 devices
                 for BOTH hosts, not just the broken one. Android 12+ verifies
                 per-host. Both are served by the same relay deployment, so
                 they fail together anyway in practice. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="fleet-relay.muveeai.com" />
                <data android:scheme="https" android:host="fleet-relay.eternizedlab.com" />
            </intent-filter>

            <!-- Share target: put Fleet in the system share sheet so text or
                 files from any other app land straight in a new-session draft
                 (see src/shareTarget.ts). text/* is listed separately from */*
                 because some senders match only the narrower filter. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 配对门里的应用内扫码（src/views/PairScanner.tsx）。只声明就够了：
         Capacitor 的 BridgeWebChromeClient.onPermissionRequest 已经把 WebView
         的 VIDEO_CAPTURE 请求映射成这个运行时权限并代为申请。
         required=false：扫码只是两条配对入口之一，没有摄像头的设备照样能用
         粘贴配对，不该因此在应用市场被判为不兼容。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 语音输入（src/voiceCapacitor.ts）。RECORD_AUDIO 不在这里声明：
         @capgo/capacitor-speech-recognition 自己的 manifest 带了它，会 merge 进来。

         需要显式声明的是这段 <queries>：Android 11 (API 30) 起有 package
         visibility 限制，而插件判可用性用的是
         SpeechRecognizer.isRecognitionAvailable()，它内部要查询系统里的
         RecognitionService。没有这段声明，那次查询在 API 30+ 上看不见服务，
         于是即便设备装了识别引擎也会被判成不可用、语音按钮整个不出现。

         注：本条按 Android package visibility 的机制推断而来，尚未在真机上
         对照验证（计划 voice-input-native 的 P6 真机验收要确认）。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
