# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# pnpm falls back to a cwd-local store when it can't reach the default one
# (~/.local/share/pnpm/store) — e.g. under a sandboxed HOME.
.pnpm-store/
dist
# mobile-web 的同源形态产物（`pnpm build:webui`）。另出一份而不是改默认 base，
# 因为 dist/ 有三个消费方都按根路径假设：fleet-relay 镜像、鸿蒙 rawfile、
# Capacitor 原生包。`dist` 那条 pattern 不匹配这个名字，所以要单列。
dist-webui
dist-ssr
*.local

# Rust build output
target/
target-*/
claw-fleet-desktop/binaries/

# Video pipeline output
promo/video/output/
promo/video/node_modules/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
promo/*
!promo/remotion/
promo/remotion/out/
# Demo screencast: track the pipeline scripts, not the heavy generated media.
!promo/demo-video/
promo/demo-video/*.mp4
promo/demo-video/*.webm
promo/demo-video/marks.json
promo/demo-video/subs.srt
Cargo.toml.bak

# Fleet PRD Discipline scratch state — agent-managed, not for version control
TASKS.md
.worktrees/

# Mobile app signing material — private keys, NEVER commit. Back these up
# out-of-band: losing the keystore means already-installed builds can no
# longer be upgraded in place.
.signing/